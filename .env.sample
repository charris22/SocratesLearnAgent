# Azure AI Foundry / Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Authentication - uses DefaultAzureCredential by default
# Set this only if you want to use API key auth instead:
# AZURE_OPENAI_API_KEY=

# Azure AI Foundry Project (optional - for advanced agent features)
# AZURE_AI_PROJECT_CONNECTION_STRING=

# App Settings
APP_ENV=development
LOG_LEVEL=INFO
